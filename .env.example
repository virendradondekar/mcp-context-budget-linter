# rules | anthropic | openai | ollama (default rules; falls back to rules without a key)
AI_PROVIDER=
# HTTP port (default 3000)
PORT=
# set to 1 to force mock data
MOCK_MODE=
# Bind address (default 127.0.0.1)
HOST=
# Path of the JSON file storing recent analyses (default ./db.json, gitignored)
DB_FILE=
# Optional: enables Anthropic rewrites when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: enables OpenAI rewrites when AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional: Ollama base URL (default http://localhost:11434)
OLLAMA_HOST=
# Optional: Ollama model name
OLLAMA_MODEL=
